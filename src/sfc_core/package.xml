<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <!-- 1. 包基本信息（必须） -->
  <name>sfc_core</name>
  <version>0.0.0</version>
  <description>Core module for RGBD SLAM (Astra Pro), include frontend tracking, feature extraction/matching, g2o PnP optimization</description>
  <maintainer email="your_email@example.com">Your Name</maintainer>
  <license>Apache-2.0</license>

  <!-- 2. 构建依赖（编译时需要） -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>eigen3_cmake_module</build_depend>
  <build_depend>Eigen3</build_depend>
  <build_depend>opencv_vendor</build_depend>
  <build_depend>opencv</build_depend>
  <build_depend>g2o</build_depend>

  <!-- 3. 运行依赖（运行时需要） -->
  <exec_depend>eigen3_cmake_module</exec_depend>
  <exec_depend>Eigen3</exec_depend>
  <exec_depend>opencv_vendor</exec_depend>
  <exec_depend>opencv</exec_depend>
  <exec_depend>g2o</exec_depend>

  <!-- 4. 测试依赖（可选） -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <!-- 5. 导出配置（必须） -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>